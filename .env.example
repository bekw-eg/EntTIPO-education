# Database (running on Docker mapped port 5433)
DATABASE_URL="postgresql://enttipo:entipo_secret@localhost:5433/entTIPO"

# Math validation service (running on Docker mapped port 8001)
MATH_SERVICE_URL="http://localhost:8001"

# Authentication: set a private random value before running in production.
SESSION_SECRET=""
# Explicit demo login uses only the dedicated seeded demo profile.
ENABLE_DEMO_MODE="false"

# Application
NEXT_PUBLIC_APP_NAME="Synaq"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Gemini API
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"
# Ordinary practice only: 0–5 percent, a ceiling rather than a quota.
# Sessions shorter than 20 questions always use single-answer choices.
PRACTICE_MULTI_MAX_PERCENT=5
