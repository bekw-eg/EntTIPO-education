generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  avatar    String?
  timeZone  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions      PracticeSession[]
  attempts      UserAttempt[]
  topicProgress UserTopicProgress[]
  mistakes      Mistake[]
  dailyGoals    DailyGoal[]
  skillObservations SkillObservation[]
  skillProgress UserSkillProgress[]
  diagnostics DiagnosticSession[]
  learningPlans DailyLearningPlan[]
  learningChecks LearningCheck[]
  skillReviews SkillReview[]
  questionHelp QuestionHelp[]
  exams ExamSession[]
  offlinePackages OfflinePackage[]
  learningRoads LearningRoadBlock[]
}

model Topic {
  id          String   @id @default(cuid())
  name        String
  description String
  nameKk      String?
  descriptionKk String?
  difficulty  Int      @default(1)
  order       Int
  createdAt   DateTime @default(now())

  subtopics Subtopic[]
  questions Question[]
  progress  UserTopicProgress[]
  mistakes  Mistake[]
  lesson    Lesson?
  skills    Skill[]
}

model Subtopic {
  id          String  @id @default(cuid())
  topicId     String
  name        String
  description String?
  nameKk      String?
  descriptionKk String?

  topic     Topic      @relation(fields: [topicId], references: [id])
  questions Question[]
}

model Question {
  id            String   @id @default(cuid())
  topicId       String
  subtopicId    String?
  title         String
  questionText  String
  latex         String?
  difficulty    Int      @default(1)
  correctAnswer String
  answerType    String   // expression | number | multiple_choice
  explanation   String
  createdAt     DateTime @default(now())
  titleKk       String?
  questionTextKk String?
  explanationKk String?
  localizationSource String?
  purpose       String   @default("practice") // practice | diagnostic | verification
  practiceChoice Json? // Versioned, reviewed final-answer choices; legacy/exam steps stay intact.

  topic    Topic          @relation(fields: [topicId], references: [id])
  subtopic Subtopic?      @relation(fields: [subtopicId], references: [id])
  steps    QuestionStep[]
  attempts UserAttempt[]
  mistakes Mistake[]
  skills   QuestionSkill[]
  diagnosticAnswers DiagnosticAnswer[]
  learningChecks LearningCheck[]
  questionHelp QuestionHelp[]
}

model QuestionStep {
  id             String  @id @default(cuid())
  questionId     String
  order          Int
  type           String  // multiple_choice | multiple_select | numeric_input | expression_input
  prompt         String
  expectedAnswer String
  hint           String?
  hintKk         String?
  promptKk       String?
  misconceptions Json @default("[]")

  question Question        @relation(fields: [questionId], references: [id])
  options  QuestionOption[]
  answers  UserStepAnswer[]
  skills   StepSkill[]
  mistakes Mistake[] @relation("MistakeStep")
}

model QuestionOption {
  id        String  @id @default(cuid())
  stepId    String
  text      String
  textKk    String?
  isCorrect Boolean @default(false)
  order     Int

  step QuestionStep @relation(fields: [stepId], references: [id])
}

model PracticeSession {
  id             String    @id @default(cuid())
  userId         String
  mode           String    // mixed | weak_topics | specific_topic | review_mistakes
  totalCount     Int
  completedCount Int       @default(0)
  correctCount   Int       @default(0)
  topicId        String?
  status         String    @default("active") // active | completed
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  hintedQuestionIds String[] @default([])
  questionIds    String[]  @default([])
  currentIndex   Int       @default(0)
  draftAnswers   Json      @default("{}")
  revision       Int       @default(0)
  currentAttemptId String?
  choiceSnapshots Json @default("{}") // Private immutable content and option order, never returned raw.
  legacyDraftAnswers Json @default("{}") // Archived free-text drafts from the additive upgrade.

  user     User          @relation(fields: [userId], references: [id])
  attempts UserAttempt[]
  planActions LearningPlanAction[]
  learningCheck LearningCheck?
  offlinePackage OfflinePackage?
  roadNodes LearningRoadNode[]
}

// Explicit assisted-practice export. Personal payloads never enter the shared SW cache.
model OfflinePackage {
  id String @id
  userId String
  sessionId String @unique
  language String
  contentVersion String
  selectionHash String
  content Json
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  session PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model UserAttempt {
  id            String   @id @default(cuid())
  userId        String
  questionId    String
  sessionId     String
  isCorrect     Boolean
  isPartial     Boolean  @default(false)
  score         Int      @default(0)
  usedHint      Boolean  @default(false)
  timeSpent     Int      @default(0)
  attemptNumber Int      @default(1)
  submissionId  String?
  submissionHash String?
  submissionResult Json?
  createdAt     DateTime @default(now())

  user        User             @relation(fields: [userId], references: [id])
  question    Question         @relation(fields: [questionId], references: [id])
  session     PracticeSession  @relation(fields: [sessionId], references: [id])
  stepAnswers UserStepAnswer[]
  mistakes    Mistake[]
  skillObservations SkillObservation[]
  confirmedMistakes Mistake[] @relation("MistakeConfirmation")
  learningCheck LearningCheck?
  reviewSchedules SkillReview[]

  @@unique([userId, submissionId])
  @@index([userId, createdAt])
  @@index([sessionId, questionId])
}

model UserStepAnswer {
  id        String   @id @default(cuid())
  attemptId String
  stepId    String
  answer    String
  isCorrect Boolean
  createdAt DateTime @default(now())

  attempt UserAttempt  @relation(fields: [attemptId], references: [id])
  step    QuestionStep @relation(fields: [stepId], references: [id])
}

model UserTopicProgress {
  id              String    @id @default(cuid())
  userId          String
  topicId         String
  masteryScore    Int       @default(0)
  currentLevel    Int       @default(1)
  totalAttempts   Int       @default(0)
  correctAttempts Int       @default(0)
  lastAttemptAt   DateTime?
  updatedAt       DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  topic Topic @relation(fields: [topicId], references: [id])

  @@unique([userId, topicId])
}

model Mistake {
  id            String    @id @default(cuid())
  userId        String
  questionId    String
  attemptId     String?
  examSessionId String?
  topicId       String
  subtopicId    String?
  errorType     String    // wrong_formula | calculation_error | sign_error | algebra_error | domain_error | concept_error | incorrect_method | unclassified
  weakSkill     String?
  skillId       String?
  stepId        String?
  userAnswer    String?
  correctAnswer String?
  explanation   String?
  aiReason      String?
  aiHint        String?
  description   String?
  aiAnalysisLocales Json @default("{}")
  isReviewed    Boolean   @default(false)
  reviewedAt    DateTime?
  confirmedAt   DateTime?
  confirmationAttemptId String?
  createdAt     DateTime  @default(now())

  user     User         @relation(fields: [userId], references: [id])
  question Question     @relation(fields: [questionId], references: [id])
  attempt  UserAttempt? @relation(fields: [attemptId], references: [id])
  examSession ExamSession? @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  topic    Topic        @relation(fields: [topicId], references: [id])
  skill    Skill?       @relation(fields: [skillId], references: [id], onDelete: SetNull)
  step     QuestionStep? @relation("MistakeStep", fields: [stepId], references: [id], onDelete: SetNull)
  confirmationAttempt UserAttempt? @relation("MistakeConfirmation", fields: [confirmationAttemptId], references: [id], onDelete: SetNull)
  learningChecks LearningCheck[]
  planActions LearningPlanAction[]

  @@index([userId, confirmedAt, createdAt])
}

model Skill {
  id String @id
  topicId String
  nameRu String
  nameKk String
  explanationRu String
  explanationKk String
  ruleRu String
  ruleKk String
  topic Topic @relation(fields: [topicId], references: [id])
  questions QuestionSkill[]
  steps StepSkill[]
  observations SkillObservation[]
  progress UserSkillProgress[]
  mistakes Mistake[]
  planActions LearningPlanAction[]
  learningChecks LearningCheck[]
  reviews SkillReview[]
  roadNodes LearningRoadNode[]
}

// Stable short blocks, independent of the calendar-based daily plan.
model LearningRoadBlock {
  id String @id @default(cuid())
  userId String
  sequence Int
  diagnosticId String? // Initial completed screening snapshot; never rewrites started lessons.
  programVersion Int @default(0) // 0: historical short road; 1+: preparation cycle.
  policy Json @default("{}")
  status String @default("active")
  reason String @default("initial")
  sourceExamId String? @unique
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodes LearningRoadNode[]
  @@unique([userId, sequence])
}

model LearningRoadNode {
  id String @id @default(cuid())
  blockId String
  position Int
  key String
  type String // THEORY | PRACTICE | REPAIR | REVIEW | CHECKPOINT
  skillId String
  reason String
  prerequisiteIds String[] @default([])
  questionCount Int
  estimatedMinutes Int
  sessionId String?
  completedAt DateTime?
  unavailable Boolean @default(false)
  skipped Boolean @default(false)
  phase String @default("check") // check | repair | practice
  skillIds String[] @default([])
  repairSkillIds String[] @default([])
  evidence Json?
  assessments ExamSession[]
  block LearningRoadBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id])
  session PracticeSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  @@unique([blockId, position])
  @@index([sessionId])
}

model DailyLearningPlan {
  id String @id @default(cuid())
  userId String
  day String // ISO calendar date in timeZone, never server-local midnight
  timeZone String
  status String @default("active") // active | archived
  diagnosticId String? // source snapshot; later diagnostics don't rewrite started work
  examId String? // latest completed exam used to select this plan
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  actions LearningPlanAction[]
  @@unique([userId, day])
}

model LearningPlanAction {
  id String @id @default(cuid())
  planId String
  position Int
  kind String // diagnostic | rule | practice | check
  skillId String?
  mistakeId String?
  questionIds String[] @default([])
  reasons String[] @default([])
  status String @default("ready") // ready | blocked | retry | completed | superseded
  sessionId String?
  completedAt DateTime?
  plan DailyLearningPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  skill Skill? @relation(fields: [skillId], references: [id])
  mistake Mistake? @relation(fields: [mistakeId], references: [id], onDelete: SetNull)
  session PracticeSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  @@index([planId, position])
}

// Every check is tied to one saved session and its first submitted answer.
model LearningCheck {
  id String @id @default(cuid())
  userId String
  skillId String
  mistakeId String?
  questionId String
  sessionId String @unique
  attemptId String? @unique
  purpose String // confirmation | review
  targetDifficulty Int @default(1)
  reviewVersion Int?
  status String @default("pending") // pending | passed | failed
  createdAt DateTime @default(now())
  completedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id])
  mistake Mistake? @relation(fields: [mistakeId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])
  session PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attempt UserAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  @@index([userId, skillId, status])
}

model SkillReview {
  userId String
  skillId String
  intervalIndex Int @default(0)
  dueDay String
  timeZone String
  version Int @default(0)
  lastAttemptId String?
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id])
  lastAttempt UserAttempt? @relation(fields: [lastAttemptId], references: [id], onDelete: SetNull)
  @@id([userId, skillId])
}

// Assistance persists across sessions, including AI help without a sessionId.
model QuestionHelp {
  userId String
  questionId String
  firstAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  @@id([userId, questionId])
}

model QuestionSkill {
  questionId String
  skillId String
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id])
  @@id([questionId, skillId])
  @@index([skillId])
}

model StepSkill {
  stepId String
  skillId String
  step QuestionStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id])
  @@id([stepId, skillId])
}

model SkillObservation {
  id String @id @default(cuid())
  userId String
  skillId String
  questionId String
  attemptId String?
  diagnosticAnswerId String?
  examSessionId String?
  score Int
  isCorrect Boolean
  isPartial Boolean
  usedHint Boolean
  difficulty Int
  attemptNumber Int
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id])
  attempt UserAttempt? @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  diagnosticAnswer DiagnosticAnswer? @relation(fields: [diagnosticAnswerId], references: [id], onDelete: Cascade)
  examSession ExamSession? @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  @@unique([attemptId, skillId])
  @@unique([diagnosticAnswerId, skillId])
  @@unique([examSessionId, questionId, skillId])
  @@index([userId, skillId, createdAt])
}

model UserSkillProgress {
  userId String
  skillId String
  masteryScore Int
  state String // insufficient | weak | developing | good | mastered
  observationCount Int
  distinctQuestions Int
  lastAttemptAt DateTime?
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id])
  @@id([userId, skillId])
}

model DiagnosticSession {
  id String @id @default(cuid())
  userId String
  status String @default("active")
  questionIds String[]
  currentIndex Int @default(0)
  revision Int @default(0)
  draftAnswers Json @default("{}")
  questionSnapshots Json @default("{}") // Private immutable diagnostic content.
  result Json?
  startedAt DateTime @default(now())
  completedAt DateTime?
  restartFromId String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers DiagnosticAnswer[]
  @@index([userId, startedAt])
  @@unique([userId, restartFromId])
}

model DiagnosticAnswer {
  id String @id @default(cuid())
  sessionId String
  questionId String
  submissionId String
  submissionHash String
  stepResults Json
  isCorrect Boolean
  score Int
  createdAt DateTime @default(now())
  session DiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])
  observations SkillObservation[]
  @@unique([sessionId, questionId])
  @@unique([sessionId, submissionId])
}

// Private immutable paper includes answer keys; public API must use an explicit whitelist.
model ExamSession {
  id String @id @default(cuid())
  userId String
  startRequestId String
  startHash String
  profileId String
  profileVersion String
  language String
  profileSnapshot Json
  paper Json
  questionIds String[]
  answers Json @default("{}")
  flaggedQuestionIds String[] @default([])
  currentIndex Int @default(0)
  revision Int @default(0)
  lastSaveId String?
  lastSaveHash String?
  status String @default("active")
  startedAt DateTime
  deadlineAt DateTime
  durationMinutes Int
  completedAt DateTime?
  completionReason String?
  result Json?
  roadNodeId String?
  roadNode LearningRoadNode? @relation(fields: [roadNodeId], references: [id], onDelete: SetNull)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  observations SkillObservation[]
  mistakes Mistake[]
  startRequests ExamStartRequest[]
  @@unique([userId, startRequestId])
  @@index([userId, status])
  @@index([roadNodeId])
}

model ExamStartRequest {
  userId String
  requestId String
  examId String
  startHash String
  exam ExamSession @relation(fields: [examId], references: [id], onDelete: Cascade)
  @@id([userId, requestId])
  @@index([examId])
}

model ExamBankAudit {
  id BigInt @id @default(autoincrement())
  userId String
  profileId String
  language String
  details Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@index([userId, createdAt])
}

model DailyGoal {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime @default(now())
  targetCount    Int      @default(20)
  completedCount Int      @default(0)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model Lesson {
  id           String   @id @default(cuid())
  topicId      String   @unique
  title        String
  whatIsIt     String
  whenUsed     String
  formula      String?
  formulaLatex String?
  example      String
  commonErrors String
  contentKk    Json?
  createdAt    DateTime @default(now())

  topic Topic @relation(fields: [topicId], references: [id])
}
